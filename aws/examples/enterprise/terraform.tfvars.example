aws_region  = "us-east-1"
aws_profile = "default"
name_prefix = "mz-enterprise"
license_key = "your-materialize-license-key"

# Restrict access to the EKS API server. Required (no default). For lab use
# you may pass ["0.0.0.0/0"], but production should pin a tight allowlist.
k8s_apiserver_authorized_networks = ["203.0.113.0/24"]

# Public hostnames the browser uses. After apply, point A records at the LB
# IPs. The materialize_console_fqdn is also used as the OAuth2 redirect
# URI registered with Hydra.
ory_hydra_fqdn             = "hydra.mz.example.com"
ory_ui_fqdn                = "auth.mz.example.com"
ory_kratos_fqdn            = "kratos.mz.example.com"
materialize_console_fqdn   = "console.mz.example.com"
materialize_balancerd_fqdn = "balancerd.mz.example.com"

# Optional: deploy Ory Polis (SAML-to-OIDC bridge). When true, set
# ory_polis_fqdn and point a CNAME at the polis LB hostname after apply.
# A dedicated RDS instance is provisioned for the polis database. The Polis
# chart and image are pulled through the Materialize OEL registry proxy
# using the license-key JWT above; no extra credential needed.
#
# enable_polis   = true
# ory_polis_fqdn = "polis.mz.example.com"

# Optional: bring your own cert-manager (Cluster)Issuer for browser-facing
# TLS. Leave commented out to use the in-cluster self-signed issuer (browser
# trust warnings). See the README for a Let's Encrypt + Cloudflare snippet.
# cert_issuer_ref = {
#   name = "letsencrypt-prod"
#   kind = "ClusterIssuer"
# }

# Optional: federate logins through one or more upstream IdPs (Okta, Entra,
# Auth0, Google Workspace). Each entry renders as a "Sign in with X" button
# on the selfservice UI. Leave as [] for password-only login.
# upstream_identity_providers = [
#   {
#     id            = "okta"
#     provider      = "generic"
#     client_id     = "your-okta-client-id"
#     client_secret = "your-okta-client-secret"
#     issuer_url    = "https://your-org.okta.com/oauth2/default"
#     label         = "Okta"
#   },
# ]

# Optional: sign in through Ory Polis (the SAML-to-OIDC bridge to Okta or Entra
# over SAML). Polis is the jackson provider and is configured under the Kratos
# SAML method, not as an OIDC provider, so it goes here rather than in
# upstream_identity_providers. Deploy Polis (enable_polis above), register a
# SAML connection in it, drop the Okta app's metadata in okta-metadata.xml next
# to this file, then fill these in. See the README.
# saml_providers = [
#   {
#     id            = "polis"
#     label         = "SAML"
#     client_id     = "from-polis-registration"
#     client_secret = "from-polis-registration"
#     issuer_url    = "https://polis.mz.example.com"
#     auth_url      = "https://polis.mz.example.com/api/oauth/authorize"
#     token_url     = "https://polis.mz.example.com/api/oauth/token"
#   },
# ]

tags = {
  environment = "demo"
  project     = "materialize-enterprise"
}
